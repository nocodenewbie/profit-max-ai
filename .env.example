# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Stripe Configuration
# For development, use test keys (pk_test_... and sk_test_...)
# For production, use live keys (pk_live_... and sk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_your_key_here"

# Edge Functions Secrets (Set in Supabase Dashboard)
# STRIPE_SECRET_KEY - Set in Supabase Dashboard > Edge Functions > Secrets
